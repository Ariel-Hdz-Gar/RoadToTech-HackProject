// ==============================================================================
// RETAILPULSE - ESQUEMA Y CARGA DE DATOS DE GRAFO EN TIGERGRAPH CLOUD
// Base de Datos: tienda
// Autores: Michelle & Equipo RetailPulse
// ==============================================================================

USE GRAPH tienda

// 1. ACTUALIZACIÓN DEL ESQUEMA
CREATE SCHEMA_CHANGE JOB actualizar_inventario {
  ALTER VERTEX inventario ADD ATTRIBUTE (cantidad INT);
}
RUN SCHEMA_CHANGE JOB actualizar_inventario
DROP JOB actualizar_inventario

// 2. CREACIÓN DE LAS CONSULTAS (DATOS DE LAS 4 TIENDAS)

// TIENDA A (Zona Norte / Estadio / Alta rotación Cerveza y Botanas)
CREATE OR REPLACE QUERY cargar_datos_Tienda_A() FOR GRAPH tienda {
  INSERT INTO inventario VALUES ("INV_A_001", "Leche", to_datetime("2026-10-12 00:00:00"), 35.5, 350);
  INSERT INTO inventario VALUES ("INV_A_002", "Jamón", to_datetime("2026-10-15 00:00:00"), 50.5, 200);
  INSERT INTO inventario VALUES ("INV_A_003", "Donas", to_datetime("2026-11-01 00:00:00"), 30.0, 180);
  INSERT INTO inventario VALUES ("INV_A_004", "Paketaxo", to_datetime("2026-12-01 00:00:00"), 60.0, 280);
  INSERT INTO inventario VALUES ("INV_A_005", "Atún", to_datetime("2027-05-10 00:00:00"), 22.0, 180);
  INSERT INTO inventario VALUES ("INV_A_006", "Cerveza", to_datetime("2027-08-20 00:00:00"), 95.0, 700);
  PRINT "Datos de la Tienda A insertados correctamente";
}

