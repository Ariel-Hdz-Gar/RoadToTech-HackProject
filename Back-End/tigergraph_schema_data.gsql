  PRINT "Datos de la Tienda D insertados correctamente";
}

// 3. INSTALACIÓN Y EJECUCIÓN
INSTALL QUERY cargar_datos_Tienda_A, cargar_datos_Tienda_B, cargar_datos_Tienda_C, cargar_datos_Tienda_D
RUN QUERY cargar_datos_Tienda_A()
RUN QUERY cargar_datos_Tienda_B()
RUN QUERY cargar_datos_Tienda_C()
RUN QUERY cargar_datos_Tienda_D()
