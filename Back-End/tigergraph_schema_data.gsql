// TIENDA D (Zona Corporativa / San Pedro / Canasta Básica y Oficinas)
CREATE OR REPLACE QUERY cargar_datos_Tienda_D() FOR GRAPH tienda {
  INSERT INTO inventario VALUES ("INV_D_001", "Leche", to_datetime("2026-10-12 00:00:00"), 35.5, 400);
  INSERT INTO inventario VALUES ("INV_D_002", "Jamón", to_datetime("2026-10-15 00:00:00"), 50.5, 380);
  INSERT INTO inventario VALUES ("INV_D_003", "Donas", to_datetime("2026-11-01 00:00:00"), 30.0, 200);
  INSERT INTO inventario VALUES ("INV_D_004", "Paketaxo", to_datetime("2026-12-01 00:00:00"), 60.0, 450);
  INSERT INTO inventario VALUES ("INV_D_005", "Atún", to_datetime("2027-05-10 00:00:00"), 22.0, 350);
