  INSERT INTO inventario VALUES ("INV_C_004", "Paketaxo", to_datetime("2026-12-01 00:00:00"), 60.0, 600);
  INSERT INTO inventario VALUES ("INV_C_005", "Atún", to_datetime("2027-05-10 00:00:00"), 22.0, 90);
