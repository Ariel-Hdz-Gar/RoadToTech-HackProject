USE GRAPH tienda

CREATE OR REPLACE QUERY cargar_datos_Tienda_A() FOR GRAPH tienda {
  INSERT INTO inventario VALUES ("INV_A_001", "Leche", to_datetime("2026-10-12 00:00:00"), 350);
  INSERT INTO inventario VALUES ("INV_A_002", "Jamón", to_datetime("2026-10-15 00:00:00"), 200);
  INSERT INTO inventario VALUES ("INV_A_003", "Donas", to_datetime("2026-11-01 00:00:00"), 180);
  INSERT INTO inventario VALUES ("INV_A_004", "Paketaxo", to_datetime("2026-12-01 00:00:00"), 280);
  INSERT INTO inventario VALUES ("INV_A_005", "Atún", to_datetime("2027-05-10 00:00:00"), 180);
  INSERT INTO inventario VALUES ("INV_A_006", "Cerveza", to_datetime("2027-08-20 00:00:00"), 700);
  PRINT "Datos de la Tienda A insertados correctamente";
}

